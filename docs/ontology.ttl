@prefix : <http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#> .

<http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology> rdf:type owl:Ontology ;
                                                                                 owl:versionIRI <http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology/1.0.0> ;
                                                                                 <http://purl.org/dc/terms/created> "2025-05-02"^^xsd:date ;
                                                                                 <http://purl.org/dc/terms/creator> "Eric Catalan Benavent"^^rdfs:Literal ;
                                                                                 <http://purl.org/dc/terms/description> """This is an ontology that describes important factors in the tourism industry in different cities, such as accommodations, prices, important attractions, transportation...

The purpose of the ontology is to model a large part of the relevant knowledge about tourism. It is expected that the knowledge modeled by this ontology will allow its users to make intelligent recommendations regarding possible tourist adventures. It also aims to provide valuable data that can be processed by companies in the sector and that will allow them to improve their services.

Therefore, the ontology can be used to answer questions such as:
• What hotels are there in Madrid
• What attractions are there in Barcelona
• What day is the Bilbao Carnival
• What is the price per night of the Hotel Sol"""@en ;
                                                                                 <http://purl.org/dc/terms/issued> "2025-05-02"^^xsd:date ;
                                                                                 <http://purl.org/dc/terms/license> "https://creativecommons.org/licenses/by/4.0/"^^rdfs:Literal ;
                                                                                 <http://purl.org/dc/terms/title> "Smart Tourism Advisor Ontology"@en ;
                                                                                 <http://purl.org/vocab/vann/preferredNamespacePrefix> "stao"^^rdfs:Literal ;
                                                                                 <http://purl.org/vocab/vann/preferredNamespaceUri> "http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#"^^rdfs:Literal ;
                                                                                 rdfs:label "STAO"@en ;
                                                                                 owl:priorVersion "http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology/1.0.0"^^rdfs:Literal ;
                                                                                 owl:versionInfo "1.0.0"^^rdfs:Literal .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/issued
<http://purl.org/dc/terms/issued> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
<http://purl.org/vocab/vann/preferredNamespacePrefix> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
<http://purl.org/vocab/vann/preferredNamespaceUri> rdf:type owl:AnnotationProperty .


###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
<http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#attractionIsIn
:attractionIsIn rdf:type owl:ObjectProperty ;
                owl:inverseOf :hasAttraction ;
                rdfs:domain :Attraction ;
                rdfs:range <https://dbpedia.org/page/City> ;
                rdfs:comment "Indicates in which city the attraction is located."@en ;
                rdfs:label "attractionIsIn"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#company
:company rdf:type owl:ObjectProperty ;
         rdfs:domain :Transport ;
         rdfs:range :Company ;
         rdfs:comment "Indicates the company that handles the service."@en ;
         rdfs:label "company"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#eventIsIn
:eventIsIn rdf:type owl:ObjectProperty ;
           owl:inverseOf :hasEvent ;
           rdfs:domain :Event ;
           rdfs:range <https://dbpedia.org/page/City> ;
           rdfs:comment "Indicates in which city the event is held."@en ;
           rdfs:label "eventIsIn"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#hasAttraction
:hasAttraction rdf:type owl:ObjectProperty ;
               rdfs:domain <https://dbpedia.org/page/City> ;
               rdfs:range :Attraction ;
               rdfs:comment "Relates a city to an attraction located within it."@en ;
               rdfs:label "hasAttraction"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#hasEvent
:hasEvent rdf:type owl:ObjectProperty ;
          rdfs:domain <https://dbpedia.org/page/City> ;
          rdfs:range :Event ;
          rdfs:comment "Relates a city to an event held within it."@en ;
          rdfs:label "hasEvent"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#hasHotel
:hasHotel rdf:type owl:ObjectProperty ;
          owl:inverseOf :hotelIsIn ;
          rdfs:domain <https://dbpedia.org/page/City> ;
          rdfs:range <https://schema.org/Hotel> ;
          rdfs:comment "Relates a city to a hotel located within it."@en ;
          rdfs:label "hasHotel"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#hasRestaurant
:hasRestaurant rdf:type owl:ObjectProperty ;
               owl:inverseOf :restaurantIsIn ;
               rdfs:domain <https://dbpedia.org/page/City> ;
               rdfs:range :Restaurant ;
               rdfs:comment "Relates a city to a restaurant located within it."@en ;
               rdfs:label "hasRestaurant"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#hasTransport
:hasTransport rdf:type owl:ObjectProperty ;
              owl:inverseOf :transportIsIn ;
              rdfs:domain <https://dbpedia.org/page/City> ;
              rdfs:range :Transport ;
              rdfs:comment "Relates a city to a transport located within it."@en ;
              rdfs:label "hasTransport"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#hotelIsIn
:hotelIsIn rdf:type owl:ObjectProperty ;
           rdfs:domain <https://schema.org/Hotel> ;
           rdfs:range <https://dbpedia.org/page/City> ;
           rdfs:comment "Indicates in which city the hotel is located."@en ;
           rdfs:label "hotelIsIn"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#restaurantIsIn
:restaurantIsIn rdf:type owl:ObjectProperty ;
                rdfs:domain :Restaurant ;
                rdfs:range <https://dbpedia.org/page/City> ;
                rdfs:comment "Indicates in which city the restaurant is located."@en ;
                rdfs:label "restaurantIsIn"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#transportIsIn
:transportIsIn rdf:type owl:ObjectProperty ;
               rdfs:domain :Transport ;
               rdfs:range <https://dbpedia.org/page/City> ;
               rdfs:comment "Indicates the city in which the transport is located."@en ;
               rdfs:label "transportIsIn"@en .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#attractionName
:attractionName rdf:type owl:DatatypeProperty ;
                rdfs:domain :Attraction ;
                rdfs:range xsd:string ;
                rdfs:comment "The official name or title of an attraction."@en ;
                rdfs:label "attractionName"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#attractionRating
:attractionRating rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Attraction ;
                  rdfs:range xsd:decimal ;
                  rdfs:comment "A numeric score for attractions, from 0 to 5."@en ;
                  rdfs:label "attractionRating"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#cityName
:cityName rdf:type owl:DatatypeProperty ;
          rdfs:domain <https://dbpedia.org/page/City> ;
          rdfs:range xsd:string ;
          rdfs:comment "The official name or title of a city."@en ;
          rdfs:label "cityName"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#date
:date rdf:type owl:DatatypeProperty ;
      rdfs:domain :Event ;
      rdfs:range xsd:date ;
      rdfs:comment "A calendar date related to the entity, formated as YYYY-MM-DD"@en ;
      rdfs:label "date"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#eventName
:eventName rdf:type owl:DatatypeProperty ;
           rdfs:domain :Event ;
           rdfs:range xsd:string ;
           rdfs:comment "The official name or title of an event."@en ;
           rdfs:label "eventName"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#hotelRating
:hotelRating rdf:type owl:DatatypeProperty ;
             rdfs:domain <https://schema.org/Hotel> ;
             rdfs:range xsd:decimal ;
             rdfs:comment "A numeric score for hotels, from 0 to 5."@en ;
             rdfs:label "hotelRating"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#location
:location rdf:type owl:DatatypeProperty ;
          rdfs:domain <https://dbpedia.org/page/City> ;
          rdfs:range xsd:string ;
          rdfs:comment "The latitude and longitude coordinates of a location."@en ;
          rdfs:label "location"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#orgName
:orgName rdf:type owl:DatatypeProperty ;
         rdfs:domain <http://xmlns.com/foaf/0.1/Organization> ;
         rdfs:range xsd:string ;
         rdfs:comment "The official name or title of an organization."@en ;
         rdfs:label "orgName"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#pricePerNight
:pricePerNight rdf:type owl:DatatypeProperty ;
               rdfs:domain <https://schema.org/Hotel> ;
               rdfs:range xsd:integer ;
               rdfs:comment "The cost for each night spent."@en ;
               rdfs:label "pricePerNight"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#restaurantAvgPrice
:restaurantAvgPrice rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Restaurant ;
                    rdfs:range xsd:decimal ;
                    rdfs:comment "Average cost of the restaurant."@en ;
                    rdfs:label "restaurantAvgPrice"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#restaurantRating
:restaurantRating rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Restaurant ;
                  rdfs:range xsd:decimal ;
                  rdfs:comment "A numeric score for restaurants, from 0 to 5."@en ;
                  rdfs:label "restaurantRating"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#stars
:stars rdf:type owl:DatatypeProperty ;
       rdfs:domain <https://schema.org/Hotel> ;
       rdfs:range xsd:integer ;
       rdfs:comment "A star-based rating."@en ;
       rdfs:label "stars"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#transportAvgPrice
:transportAvgPrice rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Transport ;
                   rdfs:range xsd:decimal ;
                   rdfs:comment "Average cost of the transport."@en ;
                   rdfs:label "transportAvgPrice"@en .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#AndalusianRestaurant
:AndalusianRestaurant rdf:type owl:Class ;
                      rdfs:subClassOf :Restaurant ;
                      rdfs:comment "A restaurant that primarily serves dishes of Andalusian cuisine."@en ;
                      rdfs:label "Andalusian Restaurant"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#Attraction
:Attraction rdf:type owl:Class ;
            rdfs:subClassOf [ rdf:type owl:Restriction ;
                              owl:onProperty :attractionIsIn ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass <https://dbpedia.org/page/City>
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :attractionRating ;
                              owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                              owl:onDataRange xsd:decimal
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :attractionRating ;
                              owl:maxQualifiedCardinality "5"^^xsd:nonNegativeInteger ;
                              owl:onDataRange xsd:decimal
                            ] ;
            rdfs:comment "A place which draws visitors by providing something of interest or pleasure."@en ;
            rdfs:label "Attraction"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#BeachAttraction
:BeachAttraction rdf:type owl:Class ;
                 rdfs:subClassOf :Attraction ;
                 rdfs:comment "A strip of land covered with sand, shingle, or small stones at the edge of a body of water, especially by the sea between high- and low-water marks."@en ;
                 rdfs:label "Beach Attraction"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#BeachHotel
:BeachHotel rdf:type owl:Class ;
            rdfs:subClassOf <https://schema.org/Hotel> ;
            rdfs:comment "A hotel located near a beach."@en ;
            rdfs:label "Beach Hotel"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#BicycleTransport
:BicycleTransport rdf:type owl:Class ;
                  rdfs:subClassOf :Transport ;
                  rdfs:comment "Transport service based on a vehicle consisting of two wheels held in a frame one behind the other, propelled by pedals and steered with handlebars attached to the front wheel."@en ;
                  rdfs:label "Bicycle Transport"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#BusTransport
:BusTransport rdf:type owl:Class ;
              rdfs:subClassOf :Transport ;
              rdfs:comment "Transport service based on a large motor vehicle carrying passengers by road, typically one serving the public on a fixed route and for a fare."@en ;
              rdfs:label "Bus Transport"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#BusinessHotel
:BusinessHotel rdf:type owl:Class ;
               rdfs:subClassOf <https://schema.org/Hotel> ;
               rdfs:comment "A hotel specialized in providing services to travelers on business trips."@en ;
               rdfs:label "Business Hotel"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#CheapHotel
:CheapHotel rdf:type owl:Class ;
            rdfs:subClassOf <https://schema.org/Hotel> ;
            rdfs:comment "Cheap hotels, <146 cost of price per night."@en ;
            rdfs:label "Cheap Hotel"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#Company
:Company rdf:type owl:Class ;
         rdfs:subClassOf <http://xmlns.com/foaf/0.1/Organization> ;
         rdfs:comment "A commercial business."@en ;
         rdfs:label "Company"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#CulturalAttraction
:CulturalAttraction rdf:type owl:Class ;
                    rdfs:subClassOf :Attraction ;
                    rdfs:comment "An attraction related to the ideas, customs, and social behaviour of a society."@en ;
                    rdfs:label "Cultural Attraction"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#CulturalEvent
:CulturalEvent rdf:type owl:Class ;
               rdfs:subClassOf :Event ;
               rdfs:comment "An event related to the ideas, customs, and social behaviour of a society."@en ;
               rdfs:label "Cultural Event"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#Event
:Event rdf:type owl:Class ;
       rdfs:subClassOf [ rdf:type owl:Restriction ;
                         owl:onProperty :eventIsIn ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onClass <https://dbpedia.org/page/City>
                       ] ;
       rdfs:comment "A planned public or social occasion."@en ;
       rdfs:label "Event"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#GastronomyEvent
:GastronomyEvent rdf:type owl:Class ;
                 rdfs:subClassOf :Event ;
                 rdfs:comment "An event related to or using gastronomy."@en ;
                 rdfs:label "Gastronomy Event"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#HighRatedHotel
:HighRatedHotel rdf:type owl:Class ;
                rdfs:subClassOf <https://schema.org/Hotel> ;
                rdfs:comment "Highly rated hotels, rating >4.3." ;
                rdfs:label "High Rated Hotel"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#HighStarHotel
:HighStarHotel rdf:type owl:Class ;
               rdfs:subClassOf <https://schema.org/Hotel> ;
               rdfs:comment "Hotels with high stars, > 4"@en ;
               rdfs:label "High Star Hotel"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#ItalianRestaurant
:ItalianRestaurant rdf:type owl:Class ;
                   rdfs:subClassOf :Restaurant ;
                   rdfs:comment "A restaurant that primarily serves dishes of Italian cuisine."@en ;
                   rdfs:label "Italian Restaurant"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#JapaneseRestaurant
:JapaneseRestaurant rdf:type owl:Class ;
                    rdfs:subClassOf :Restaurant ;
                    rdfs:comment "A restaurant that primarily serves dishes of Japanese cuisine."@en ;
                    rdfs:label "Japanese Restaurant"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#LuxuryHotel
:LuxuryHotel rdf:type owl:Class ;
             rdfs:subClassOf <https://schema.org/Hotel> ;
             rdfs:comment "A hotel of great comfort or elegance, especially when involving great expense."@en ;
             rdfs:label "Luxury Hotel"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#MediterraneanRestaurant
:MediterraneanRestaurant rdf:type owl:Class ;
                         rdfs:subClassOf :Restaurant ;
                         rdfs:comment "A restaurant that primarily serves dishes of Mediterranean cuisine."@en ;
                         rdfs:label "Mediterranean Restaurant"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#MexicanRestaurant
:MexicanRestaurant rdf:type owl:Class ;
                   rdfs:subClassOf :Restaurant ;
                   rdfs:comment "A restaurant that primarily serves dishes of Mexican cuisine."@en ;
                   rdfs:label "Mexican Restaurant"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#MonumentAttraction
:MonumentAttraction rdf:type owl:Class ;
                    rdfs:subClassOf :Attraction ;
                    rdfs:comment "A statue, building, or other structure erected to commemorate a notable person or event."@en ;
                    rdfs:label "Monument Attraction"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#MuseumAttraction
:MuseumAttraction rdf:type owl:Class ;
                  rdfs:subClassOf :Attraction ;
                  rdfs:comment "A building in which objects of historical, scientific, artistic, or cultural interest are stored and exhibited."@en ;
                  rdfs:label "Museum Attraction"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#MusicEvent
:MusicEvent rdf:type owl:Class ;
            rdfs:subClassOf :Event ;
            rdfs:comment "An event related to or using music."@en ;
            rdfs:label "Music Event"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#ParkAttraction
:ParkAttraction rdf:type owl:Class ;
                rdfs:subClassOf :Attraction ;
                rdfs:comment "A large public garden or area of land used for recreation."@en ;
                rdfs:label "Park Attraction"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#Restaurant
:Restaurant rdf:type owl:Class ;
            rdfs:subClassOf <http://xmlns.com/foaf/0.1/Organization> ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :restaurantIsIn ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass <https://dbpedia.org/page/City>
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :restaurantRating ;
                              owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                              owl:onDataRange xsd:decimal
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :restaurantRating ;
                              owl:maxQualifiedCardinality "5"^^xsd:nonNegativeInteger ;
                              owl:onDataRange xsd:decimal
                            ] ;
            rdfs:comment "A place where people pay to sit and eat meals that are cooked and served on the premises."@en ;
            rdfs:label "Restaurant"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#SportsEvent
:SportsEvent rdf:type owl:Class ;
             rdfs:subClassOf :Event ;
             rdfs:comment "An event related to or using sports."@en ;
             rdfs:label "Sports Event"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#SubwayTransport
:SubwayTransport rdf:type owl:Class ;
                 rdfs:subClassOf :Transport ;
                 rdfs:comment "Transport service based on a railway system in which electric trains travel through tunnels below ground."@en ;
                 rdfs:label "Subway Transport"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#TaxiTransport
:TaxiTransport rdf:type owl:Class ;
               rdfs:subClassOf :Transport ;
               rdfs:comment "Transport service based on a motor vehicle licensed to transport passengers in return for payment of a fare and typically fitted with a taximeter."@en ;
               rdfs:label "Taxi Transport"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#TechnologyEvent
:TechnologyEvent rdf:type owl:Class ;
                 rdfs:subClassOf :Event ;
                 rdfs:comment "An event related to or using technology."@en ;
                 rdfs:label "Technology Event"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#TouristicHotel
:TouristicHotel rdf:type owl:Class ;
                rdfs:subClassOf <https://schema.org/Hotel> ;
                rdfs:comment "A hotel specialized in providing services to tourists."@en ;
                rdfs:label "Touristic Hotel"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#TramTransport
:TramTransport rdf:type owl:Class ;
               rdfs:subClassOf :Transport ;
               rdfs:comment "Transport service based on a passenger vehicle powered by electricity conveyed by overhead cables, and running on rails laid in a public road."@en ;
               rdfs:label "Tram Transport"@en .


###  http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#Transport
:Transport rdf:type owl:Class ;
           rdfs:subClassOf [ rdf:type owl:Restriction ;
                             owl:onProperty :company ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass :Company
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :transportIsIn ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass <https://dbpedia.org/page/City>
                           ] ;
           rdfs:comment "A system or means of conveying people or goods from place to place."@en ;
           rdfs:label "Transport"@en .


###  http://xmlns.com/foaf/0.1/Organization
<http://xmlns.com/foaf/0.1/Organization> rdf:type owl:Class ;
