#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Attraction
                :Event
                :Transport
                <http://xmlns.com/foaf/0.1/Organization>
                <https://dbpedia.org/page/City>
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Company
                :Restaurant
                <https://schema.org/Hotel>
              )
] .


