}, {
  "@id" : "http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2025-05-02"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@type" : "http://www.w3.org/2000/01/rdf-schema#Literal",
    "@value" : "Eric Catalan Benavent"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "This is an ontology that describes important factors in the tourism industry in different cities, such as accommodations, prices, important attractions, transportation...\n\nThe purpose of the ontology is to model a large part of the relevant knowledge about tourism. It is expected that the knowledge modeled by this ontology will allow its users to make intelligent recommendations regarding possible tourist adventures. It also aims to provide valuable data that can be processed by companies in the sector and that will allow them to improve their services.\n\nTherefore, the ontology can be used to answer questions such as:\n• What hotels are there in Madrid\n• What attractions are there in Barcelona\n• What day is the Bilbao Carnival\n• What is the price per night of the Hotel Sol"
  } ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2025-05-02"
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@type" : "http://www.w3.org/2000/01/rdf-schema#Literal",
    "@value" : "https://creativecommons.org/licenses/by/4.0/"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "Smart Tourism Advisor Ontology"
  } ],
  "http://purl.org/vocab/vann/preferredNamespacePrefix" : [ {
    "@type" : "http://www.w3.org/2000/01/rdf-schema#Literal",
    "@value" : "stao"
  } ],
  "http://purl.org/vocab/vann/preferredNamespaceUri" : [ {
    "@type" : "http://www.w3.org/2000/01/rdf-schema#Literal",
    "@value" : "http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "STAO"
  } ],
  "http://www.w3.org/2002/07/owl#priorVersion" : [ {
    "@type" : "http://www.w3.org/2000/01/rdf-schema#Literal",
    "@value" : "http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology/1.0.0"
  } ],
  "http://www.w3.org/2002/07/owl#versionIRI" : [ {
    "@id" : "http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology/1.0.0"
  } ],
