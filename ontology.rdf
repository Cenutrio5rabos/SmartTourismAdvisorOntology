<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology/"
     xml:base="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology/"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:SmartTourismAdvisorOntology="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology">
        <owl:versionIRI rdf:resource="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology/1.0.0"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-05-02</terms:created>
        <terms:creator rdf:datatype="http://www.w3.org/2000/01/rdf-schema#Literal">Eric Catalan Benavent</terms:creator>
        <terms:description xml:lang="en">This is an ontology that describes important factors in the tourism industry in different cities, such as accommodations, prices, important attractions, transportation...

The purpose of the ontology is to model a large part of the relevant knowledge about tourism. It is expected that the knowledge modeled by this ontology will allow its users to make intelligent recommendations regarding possible tourist adventures. It also aims to provide valuable data that can be processed by companies in the sector and that will allow them to improve their services.

Therefore, the ontology can be used to answer questions such as:
• What hotels are there in Madrid
• What attractions are there in Barcelona
• What day is the Bilbao Carnival
• What is the price per night of the Hotel Sol</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-05-02</terms:issued>
        <terms:license rdf:datatype="http://www.w3.org/2000/01/rdf-schema#Literal">https://creativecommons.org/licenses/by/4.0/</terms:license>
        <terms:title xml:lang="en">Smart Tourism Advisor Ontology</terms:title>
        <vann:preferredNamespacePrefix rdf:datatype="http://www.w3.org/2000/01/rdf-schema#Literal">stao</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri rdf:datatype="http://www.w3.org/2000/01/rdf-schema#Literal">http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#</vann:preferredNamespaceUri>
        <rdfs:label xml:lang="en">STAO</rdfs:label>
        <owl:priorVersion rdf:datatype="http://www.w3.org/2000/01/rdf-schema#Literal">http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology/1.0.0</owl:priorVersion>
        <owl:versionInfo rdf:datatype="http://www.w3.org/2000/01/rdf-schema#Literal">1.0.0</owl:versionInfo>
    </owl:Ontology>
    


