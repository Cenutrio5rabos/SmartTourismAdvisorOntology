    <!-- http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#Transport -->

    <owl:Class rdf:about="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#Transport">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#company"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
