    <!-- http://purl.org/dc/terms/created -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/creator -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/issued -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/issued"/>
    


    <!-- http://purl.org/dc/terms/license -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->

    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespaceUri -->

    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri"/>
    


    <!-- http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled -->

    <owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#date -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#attractionIsIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#attractionIsIn">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#hasAttraction"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#Attraction"/>
        <rdfs:range rdf:resource="https://dbpedia.org/page/City"/>
        <rdfs:comment xml:lang="en">Indicates in which city the attraction is located.</rdfs:comment>
        <rdfs:label xml:lang="en">attractionIsIn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#company -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#company">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#Transport"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#Company"/>
        <rdfs:comment xml:lang="en">Indicates the company that handles the service.</rdfs:comment>
        <rdfs:label xml:lang="en">company</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#eventIsIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#eventIsIn">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#hasEvent"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#Event"/>
        <rdfs:range rdf:resource="https://dbpedia.org/page/City"/>
        <rdfs:comment xml:lang="en">Indicates in which city the event is held.</rdfs:comment>
        <rdfs:label xml:lang="en">eventIsIn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#hasAttraction -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#hasAttraction">
        <rdfs:domain rdf:resource="https://dbpedia.org/page/City"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#Attraction"/>
        <rdfs:comment xml:lang="en">Relates a city to an attraction located within it.</rdfs:comment>
        <rdfs:label xml:lang="en">hasAttraction</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#hasEvent -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#hasEvent">
        <rdfs:domain rdf:resource="https://dbpedia.org/page/City"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#Event"/>
        <rdfs:comment xml:lang="en">Relates a city to an event held within it.</rdfs:comment>
        <rdfs:label xml:lang="en">hasEvent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#hasHotel -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#hasHotel">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#hotelIsIn"/>
        <rdfs:domain rdf:resource="https://dbpedia.org/page/City"/>
        <rdfs:range rdf:resource="https://schema.org/Hotel"/>
        <rdfs:comment xml:lang="en">Relates a city to a hotel located within it.</rdfs:comment>
        <rdfs:label xml:lang="en">hasHotel</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#hasRestaurant -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#hasRestaurant">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#restaurantIsIn"/>
        <rdfs:domain rdf:resource="https://dbpedia.org/page/City"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#Restaurant"/>
        <rdfs:comment xml:lang="en">Relates a city to a restaurant located within it.</rdfs:comment>
        <rdfs:label xml:lang="en">hasRestaurant</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#hasTransport -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#hasTransport">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#transportIsIn"/>
        <rdfs:domain rdf:resource="https://dbpedia.org/page/City"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#Transport"/>
        <rdfs:comment xml:lang="en">Relates a city to a transport located within it.</rdfs:comment>
        <rdfs:label xml:lang="en">hasTransport</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#hotelIsIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#hotelIsIn">
        <rdfs:domain rdf:resource="https://schema.org/Hotel"/>
        <rdfs:range rdf:resource="https://dbpedia.org/page/City"/>
        <rdfs:comment xml:lang="en">Indicates in which city the hotel is located.</rdfs:comment>
        <rdfs:label xml:lang="en">hotelIsIn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#restaurantIsIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#restaurantIsIn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#Restaurant"/>
        <rdfs:range rdf:resource="https://dbpedia.org/page/City"/>
        <rdfs:comment xml:lang="en">Indicates in which city the restaurant is located.</rdfs:comment>
        <rdfs:label xml:lang="en">restaurantIsIn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#transportIsIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#transportIsIn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#Transport"/>
        <rdfs:range rdf:resource="https://dbpedia.org/page/City"/>
        <rdfs:comment xml:lang="en">Indicates the city in which the transport is located.</rdfs:comment>
        <rdfs:label xml:lang="en">transportIsIn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#attractionName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#attractionName">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#Attraction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The official name or title of an attraction.</rdfs:comment>
        <rdfs:label xml:lang="en">attractionName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#attractionRating -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#attractionRating">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#Attraction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">A numeric score for attractions, from 0 to 5.</rdfs:comment>
        <rdfs:label xml:lang="en">attractionRating</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#cityName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#cityName">
        <rdfs:domain rdf:resource="https://dbpedia.org/page/City"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The official name or title of a city.</rdfs:comment>
        <rdfs:label xml:lang="en">cityName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#date -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#date">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">A calendar date related to the entity, formated as YYYY-MM-DD</rdfs:comment>
        <rdfs:label xml:lang="en">date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#eventName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#eventName">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The official name or title of an event.</rdfs:comment>
        <rdfs:label xml:lang="en">eventName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#hotelRating -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#hotelRating">
        <rdfs:domain rdf:resource="https://schema.org/Hotel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">A numeric score for hotels, from 0 to 5.</rdfs:comment>
        <rdfs:label xml:lang="en">hotelRating</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#location -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#location">
        <rdfs:domain rdf:resource="https://dbpedia.org/page/City"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The latitude and longitude coordinates of a location.</rdfs:comment>
        <rdfs:label xml:lang="en">location</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#orgName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#orgName">
        <rdfs:domain rdf:resource="http://xmlns.com/foaf/0.1/Organization"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The official name or title of an organization.</rdfs:comment>
        <rdfs:label xml:lang="en">orgName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#pricePerNight -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#pricePerNight">
        <rdfs:domain rdf:resource="https://schema.org/Hotel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">The cost for each night spent.</rdfs:comment>
        <rdfs:label xml:lang="en">pricePerNight</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#restaurantAvgPrice -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#restaurantAvgPrice">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#Restaurant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Average cost of the restaurant.</rdfs:comment>
        <rdfs:label xml:lang="en">restaurantAvgPrice</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#restaurantRating -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#restaurantRating">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#Restaurant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">A numeric score for restaurants, from 0 to 5.</rdfs:comment>
        <rdfs:label xml:lang="en">restaurantRating</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#stars -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#stars">
        <rdfs:domain rdf:resource="https://schema.org/Hotel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">A star-based rating.</rdfs:comment>
        <rdfs:label xml:lang="en">stars</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#transportAvgPrice -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#transportAvgPrice">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#Transport"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Average cost of the transport.</rdfs:comment>
        <rdfs:label xml:lang="en">transportAvgPrice</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#AndalusianRestaurant -->

    <owl:Class rdf:about="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#AndalusianRestaurant">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#Restaurant"/>
        <rdfs:comment xml:lang="en">A restaurant that primarily serves dishes of Andalusian cuisine.</rdfs:comment>
        <rdfs:label xml:lang="en">Andalusian Restaurant</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#Attraction -->

    <owl:Class rdf:about="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#Attraction">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#attractionIsIn"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://dbpedia.org/page/City"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#attractionRating"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#attractionRating"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">5</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A place which draws visitors by providing something of interest or pleasure.</rdfs:comment>
        <rdfs:label xml:lang="en">Attraction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#BeachAttraction -->

    <owl:Class rdf:about="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#BeachAttraction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#Attraction"/>
        <rdfs:comment xml:lang="en">A strip of land covered with sand, shingle, or small stones at the edge of a body of water, especially by the sea between high- and low-water marks.</rdfs:comment>
        <rdfs:label xml:lang="en">Beach Attraction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#BeachHotel -->

    <owl:Class rdf:about="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#BeachHotel">
        <rdfs:subClassOf rdf:resource="https://schema.org/Hotel"/>
        <rdfs:comment xml:lang="en">A hotel located near a beach.</rdfs:comment>
        <rdfs:label xml:lang="en">Beach Hotel</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#BicycleTransport -->

    <owl:Class rdf:about="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#BicycleTransport">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/eric/ontologies/2025/3/SmartTourismAdvisorOntology#Transport"/>
        <rdfs:comment xml:lang="en">Transport service based on a vehicle consisting of two wheels held in a frame one behind the other, propelled by pedals and steered with handlebars attached to the front wheel.</rdfs:comment>
        <rdfs:label xml:lang="en">Bicycle Transport</rdfs:label>
    </owl:Class>
    


